import numpy as np
import matplotlib.pyplot as plt
from sympy import isprime

'''GLOBAL VARIABLES'''
analysis_data = open('Analysis_Data', 'w')

l = 360 # Encoded signal loop length
n = 25 # Number of retransmissions
T_signal = 72 # Signal period
T_noise = 12 # Noise period
nyquist_limit = int(T_signal / 2)

'''FUNCTIONS'''

def make_signal(t, T):
    return np.sin(2*np.pi*t/T) # You can change this to your own signal function, ensure you use fixed length t

def noise(signal, T): # You can create own noise function, ensure periodic &  small T
    t = np.arange(len(signal))
    return np.sin(2*np.pi*t/T - T/2)

def sample(noisy_signal, w):
    samples = noisy_signal[::w]
    t = np.arange(len(noisy_signal))
    t_samples = t[::w]
    return np.interp(t, t_samples, samples)

def sample_and_reconstruct(noisy_signal, w, amplitude):
    # Sampling and averaging
    chunks = sample(noisy_signal, w).reshape(n, l)
    reconstructed = np.mean(chunks, axis=0)

    # # Error corrections
    # t = np.arange(len(reconstructed))
    # best_fit = np.polyfit(t, reconstructed, 1)
    # reconstructed -= best_fit[0] * t # Correct tilt

    # reconstructed_origin = (np.max(reconstructed) + np.min(reconstructed)) / 2
    # reconstructed -= reconstructed_origin # Correct origin
    
    # reconstructed_amplitude = (np.max(reconstructed) - np.min(reconstructed)) / 2
    
    # if reconstructed_amplitude != 0:
    #     reconstructed *= amplitude / reconstructed_amplitude # Correct amplitude

    return chunks, reconstructed

'''MAIN'''

# 1 - Prepare signal for transmission

t = np.arange(l) # Time vector
signal = make_signal(t, T_signal)
repeated_signal = np.tile(signal, n)
noisy_signal = repeated_signal + noise(repeated_signal, T_noise)

# 2 - Receive and decode signal, interactive plot

plt.ion()
fig, ax = plt.subplots()

w_ceiling = l # Max sampling window
noise_powers = np.array([])

for w in range(1, w_ceiling):
    # Clear previous frame
    ax.clear()

    chunks, reconstructed = sample_and_reconstruct(noisy_signal, w, amplitude=1)

    noise_power = np.mean((reconstructed - signal) ** 2) # Calculating noise power
    print(noise_power)

    # You can do the exact same for other analyses.

    noise_powers = np.append(noise_powers, noise_power)

    # Transpose chunks (.T) to plot all at once
    ax.plot(t, np.asarray(chunks).T, color='gray', alpha=0.1)
   
    # ax.plot(t, signal, label="original signal", linestyle='dashed', color='blue')
    ax.plot(t, noisy_signal[:l], label="noisy signal",  color='purple')

    # Replot
    ax.plot(t, reconstructed, label=f"w = {w}", linestyle='dashed', color='orange', alpha=1)

    ax.legend(loc="upper right")

    # Redraw figure
    plt.draw()

    # Tiny pause so GUI updates
    plt.pause(0.01)
    
    # if w == 1:
    #     plt.pause(10)
    #     input('Press enter to continue... ')

    analysis_data.write(f"Sample Window = {w}\nMean Square Error = {noise_power}\nReconstructed Signal = {reconstructed}\n\n")

plt.ioff()
plt.show()
analysis_data.close()

# 3 - Plot overall results

plt.plot(range(1, w_ceiling), noise_powers, label="noise_powers", color='gray')

# Prime markers
prime_x = []
prime_y = []

for w in range(1, w_ceiling):
    if isprime(w):
        prime_x.append(w)
        prime_y.append(noise_powers[w-1])

# Composite markers
composite_x = []
composite_y = []

for w in range(1, w_ceiling):
    if not isprime(w) and w % 12 == 0:
        composite_x.append(w)
        composite_y.append(noise_powers[w-1])

plt.scatter(prime_x, prime_y, color='red', s=15, label='prime w')
plt.scatter(composite_x, composite_y, color='blue', s=15, label='multiples of noise period')
plt.scatter(nyquist_limit, noise_powers[nyquist_limit-1], marker='x', color='green', s=100, label='nyquist limit')
